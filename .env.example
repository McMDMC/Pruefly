# --- access ---------------------------------------------------------------
# Required in production. The API fails closed (503) when this is empty and PRUEFLY_ENV != dev.
PRUEFLY_ACCESS_CODE=change-me
PRUEFLY_ENV=prod            # prod | dev  (dev disables the access code; never use on a public URL)

# --- model routing --------------------------------------------------------
# Comma-separated provider order per task. First that succeeds (call AND parse) wins.
# Providers: anthropic | gemini | fake
PRUEFLY_DERENDER_PROVIDERS=anthropic,gemini
PRUEFLY_TRANSFORM_PROVIDERS=anthropic,gemini

# --- anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=
PRUEFLY_ANTHROPIC_MODEL=claude-sonnet-5-5

# --- gemini (Vertex AI, uses Application Default Credentials) -------------
PRUEFLY_GEMINI_PROJECT=
PRUEFLY_GEMINI_LOCATION=europe-west1   # use "global" if the model is not offered in your region
PRUEFLY_GEMINI_MODEL=gemini-3.5-flash  # verify the exact id in the Vertex model list

# --- limits ---------------------------------------------------------------
PRUEFLY_MAX_IMAGE_BYTES=8000000
PRUEFLY_RATE_LIMIT_PER_HOUR=60
